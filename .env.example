# Copy to .env, fill in, then:  set -a; source .env; set +a
# Never commit the real .env file.

# --- Where things are stored
GREENLIGHT_DATABASE_URL=sqlite:///greenlight.db
GREENLIGHT_WORKSPACE=./workspaces

# --- Code host: "github" for the real GitHub App, "local" for the offline demo
CODE_HOST=github
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./greenlight-app.private-key.pem
GITHUB_WEBHOOK_SECRET=

# --- AI model (any OpenAI-compatible endpoint)
# OpenAI:      LLM_BASE_URL empty
# Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Used in order when the main model is out of quota, e.g. gemini-flash-latest,gemini-3.5-flash
LLM_FALLBACK_MODELS=
# Prices per 1 million tokens (USD) from your provider's pricing page, for cost tracking.
LLM_INPUT_PRICE_PER_M=0
LLM_OUTPUT_PRICE_PER_M=0
# Free tiers allow only a few calls per minute: wait this many seconds between calls.
LLM_MIN_INTERVAL_SECONDS=0
# Models that 'think' first (e.g. Gemini 2.5): low keeps answers fast and cheap. Leave empty otherwise.
LLM_REASONING_EFFORT=

# --- Sandbox: "docker" (real isolation). "local" only for your own demo repos.
SANDBOX_BACKEND=docker
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0

# --- Budgets
MAX_AGENT_STEPS=15
MAX_REPAIR_ATTEMPTS=2
MAX_COST_USD_PER_INCIDENT=0.50
MAX_INCIDENT_SECONDS=600
FLAKY_RERUNS=3

# --- Web
PUBLIC_URL=http://localhost:8000
# Set these when the dashboard is on the internet:
DASHBOARD_PASSWORD=
ADMIN_TOKEN=
